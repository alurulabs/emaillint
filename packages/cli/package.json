{
  "name": "@emaillint/cli",
  "version": "0.13.0",
  "description": "Lint HTML emails from the command line and in CI. Powered by emaillint-core.",
  "license": "MIT",
  "author": "alurulabs",
  "keywords": ["email", "html-email", "lint", "linter", "cli", "command-line", "compatibility"],
  "homepage": "https://github.com/alurulabs/emaillint#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alurulabs/emaillint.git",
    "directory": "packages/cli"
  },
  "bugs": "https://github.com/alurulabs/emaillint/issues",
  "engines": { "node": ">=20" },
  "publishConfig": { "access": "public" },
  "files": ["dist"],
  "type": "module",
  "bin": { "emaillint": "dist/index.js" },
  "main": "./dist/index.js",
  "dependencies": {
    "emaillint-core": "^0.13.0",
    "tinyglobby": "^0.2.17"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  }
}
