{
  "name": "emaillint-core",
  "version": "0.12.0",
  "description": "Deterministic static analysis engine for HTML emails. Finds unsupported or inconsistently-rendered HTML/CSS before you send a campaign.",
  "license": "MIT",
  "author": "alurulabs",
  "keywords": ["email", "html-email", "lint", "linter", "static-analysis", "email-client", "compatibility", "outlook"],
  "homepage": "https://github.com/alurulabs/emaillint#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alurulabs/emaillint.git",
    "directory": "packages/core"
  },
  "bugs": "https://github.com/alurulabs/emaillint/issues",
  "engines": { "node": ">=20" },
  "publishConfig": { "access": "public" },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "corpus": "tsx scripts/corpus.ts",
    "labeled": "tsx scripts/labeled.ts",
    "scoring-sim": "tsx scripts/scoring-sim.ts",
    "sync-compat": "tsx scripts/sync-compat.ts",
    "baseline-probe": "tsx scripts/baseline-identity-probe.ts"
  },
  "dependencies": {
    "parse5": "^8.0.1",
    "postcss": "^8.5.25"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsx": "^4.23.4",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
